# Nur fuer docker-compose.yml im Projektstamm (lokaler Test / LAN).
# Port, auf dem der Server erreichbar ist
CLYDE_PORT=8484
# Erster Admin; ohne Passwort erzeugt der Server eins und schreibt es ins Log
CLYDE_ADMIN_USER=admin
CLYDE_ADMIN_PASSWORD=
# Optional: alter gemeinsamer Token, gilt als Client-Token des Admins
CLYDE_TOKEN=
