# Domain, unter der Clyde erreichbar ist (DNS muss auf den Server zeigen)
CLYDE_DOMAIN=clyde.example.com

# Erster Admin, wird nur beim allerersten Start angelegt. Ohne Passwort erzeugt
# der Server eins und schreibt es einmalig ins Log (docker compose logs clyde).
# Danach Passwort im Dashboard unter "Konto" aendern.
CLYDE_ADMIN_USER=admin
CLYDE_ADMIN_PASSWORD=

# Optional, nur fuer bestehende Installationen: alter gemeinsamer Token. Er gilt
# als Client-Token des Admins. Neue PCs bekommen eigene Tokens im Dashboard.
CLYDE_TOKEN=

# Port auf 127.0.0.1 des Servers, nur fuer lokale Health-Checks
CLYDE_BIND_PORT=8484

# Traefik: so eintragen, wie es in der Traefik-Konfiguration heisst
PROXY_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
